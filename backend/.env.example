APP_NAME=AI Agent Tester API
APP_ENV=development
HOST=0.0.0.0
PORT=8081
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# PostgreSQL (tạo DB: createdb ai_agent_tester)
DATABASE_URL=postgresql+asyncpg://localhost/ai_agent_tester

# LLM — dự án dùng OpenAI. Không commit key thật.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# real = OpenAI thật + Playwright thật (cần: pip install, "playwright install chromium").
# fake  = FakePlanner + SimulatedRunner, không cần mạng/key/trình duyệt (test tự động, demo dự phòng).
AGENT_MODE=real

# M3a — chạy test giả lập khi AGENT_MODE=fake (mỗi bước chờ rồi "passed", không mở trình duyệt)
SIMULATED_STEP_SECONDS=2
HUMAN_INPUT_TIMEOUT_SECONDS=600

# M6 — thư mục lưu ảnh chụp / ảnh diff (mặc định backend/data/artifacts, đã gitignore)
# ARTIFACTS_DIR=/đường/dẫn/khác

# M7 — đăng nhập. AUTH_REQUIRED=false chỉ dùng cho test tự động (mọi request coi như user demo).
AUTH_REQUIRED=true
SESSION_DAYS=7
# true khi chạy HTTPS (production)
COOKIE_SECURE=false

# M8 — chống SSRF. Chỉ bật true khi target là máy local (demo), KHÔNG bật ở production.
ALLOW_PRIVATE_TARGETS=false
